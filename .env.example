# Copy this file to .env and fill in the values. Never commit .env.

# --- Storage (Lot 1): memory | postgres
# memory: unit tests and quick development. postgres: POC, benchmarks and demo.
STORE=memory
# Shared PostgreSQL (infra/postgres/compose.yml). Local development credentials only.
POSTGRES_USER=maison
POSTGRES_PASSWORD=maison_dev
CATALOGUE_DATABASE_URL=postgres://maison:maison_dev@localhost:5432/catalogue
TROC_DATABASE_URL=postgres://maison:maison_dev@localhost:5432/troc
NOTIFICATIONS_DATABASE_URL=postgres://maison:maison_dev@localhost:5432/notifications
# Enables the PostgreSQL integration tests (they are skipped when empty).
TEST_POSTGRES_URL=

# --- Messaging (Lot 4): memory | kafka | rabbitmq
BROKER=memory
KAFKA_BROKERS=localhost:9092
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# --- SSO (Lot 3): none | keycloak | auth0   (none is refused when NODE_ENV=production)
SSO=none
SSO_ISSUER=
SSO_AUDIENCE=
SSO_JWKS_URI=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# --- CI/CD (Lot 2)
GH_BENCH_TOKEN=
TEAMCITY_URL=http://localhost:8111
TEAMCITY_TOKEN=
SONAR_TOKEN=
