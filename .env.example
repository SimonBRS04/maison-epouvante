# Copy this file to .env and fill in the values. Never commit .env.

# --- Messaging (Lot 4): memory | kafka | rabbitmq
BROKER=memory
KAFKA_BROKERS=localhost:9092
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# --- SSO (Lot 3): none | keycloak | auth0   (none is refused when NODE_ENV=production)
SSO=none
SSO_ISSUER=
SSO_AUDIENCE=
SSO_JWKS_URI=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# --- CI/CD (Lot 2)
GH_BENCH_TOKEN=
TEAMCITY_URL=http://localhost:8111
TEAMCITY_TOKEN=
SONAR_TOKEN=
