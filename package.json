{
  "name": "maison-epouvante",
  "version": "0.1.0",
  "private": true,
  "description": "POC « La Petite Maison de l'Épouvante » — comparatifs CI/CD, SSO et brokers (BLOC 3)",
  "type": "module",
  "engines": {
    "node": "24"
  },
  "workspaces": [
    "services/catalogue",
    "services/troc",
    "services/notifications",
    "services/shared/*",
    "packages/*",
    "bench/*",
    "dashboard"
  ],
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "npm test --workspaces --if-present",
    "validate:results": "node scripts/validate-results.js",
    "start:catalogue": "npm start -w services/catalogue",
    "start:troc": "npm start -w services/troc",
    "start:notifications": "npm start -w services/notifications",
    "bench:cicd": "node bench/cicd/index.js",
    "bench:sso": "node bench/sso/index.js",
    "bench:brokers": "node bench/brokers/index.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@maison-epouvante/bench-kit": "0.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "vitest": "^5.1.2"
  }
}
